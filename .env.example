# =====================================================================
# 复制为 .env 后填写。所有 API 密钥只能放在此文件或真实环境变量中，
# 绝不写入源码、日志或示例配置的真实值。
# =====================================================================

# ---------- QQ 权限（必填，默认全部拒绝） ----------
# 允许调用模型的 QQ 用户 ID，逗号分隔。留空则任何人都无法调用（只能 /help）
QQ_ALLOWED_USER_IDS=
# 允许响应的群 ID，逗号分隔。不在名单中的群完全静默
QQ_ALLOWED_GROUP_IDS=
# 需要忽略的用户 ID（例如群内其他机器人），防止机器人之间无限互相回复
QQ_IGNORE_USER_IDS=

# ---------- 存储 ----------
# SQLite 数据库路径（上下文按 群×用户×Agent 隔离保存于此）
DATABASE_PATH=data/bot.db

# ---------- Agent: GPT（OpenAI 兼容接口） ----------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 单独禁用某个 Agent：改为 false
OPENAI_ENABLED=true

# ---------- Agent: DeepSeek ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=true

# ---------- Agent: GLM（智谱） ----------
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_MODEL=glm-4
GLM_ENABLED=true

# ---------- Agent: Codex（本机 CLI，使用已有 ChatGPT 登录） ----------
CODEX_ENABLED=false
CODEX_BINARY=codex
CODEX_WORKDIR=.
# 空值自动选择本机缓存中的首个可用模型
CODEX_MODEL=
# API 可选模型/强度白名单（JSON），须按账号及服务商支持情况配置。
# 不配置时仅允许上面的默认模型，且不发送 reasoning_effort。
# OPENAI_MODEL_OPTIONS={"account-model": ["low", "high"]}

# ---------- OneBot 接入 ----------
# onebot_ws  : 本程序作为 WebSocket 客户端连接 OneBot 实现的 WS 服务端（推荐）
# onebot_http: 本程序提供 HTTP 事件上报接口，通过 OneBot HTTP API 发送消息
TRANSPORT=onebot_ws
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_HTTP_API_URL=http://127.0.0.1:5700
# 与 OneBot 实现约定相同的 access token（局域网部署也强烈建议设置）
ONEBOT_ACCESS_TOKEN=
# 本程序 HTTP 服务（健康检查 / 状态接口 / HTTP 模式的事件上报）监听地址
HTTP_LISTEN_HOST=127.0.0.1
HTTP_LISTEN_PORT=8080

# ---------- 可靠性 ----------
# 每次模型请求的超时（秒）
REQUEST_TIMEOUT_SECONDS=60
# 每个上下文最多保留多少轮（一轮 = 用户 + 助手各一条）
MAX_CONTEXT_TURNS=8
# 单条 QQ 消息最大长度，超出自动分段
MAX_MESSAGE_LENGTH=1500
# 回复附带思考过程的最大字符数（超出截断；0 表示不附带）
MAX_THINKING_CHARS=800
# 完整思考过程归档目录（相对工作目录，按 task_id 存 .md；留空表示不归档）
THINKING_ARCHIVE_DIR=runtime/state/thinking
# true 时同一「群 × 用户」下所有 Agent 共用一条上下文，互相可见（Agent 间对话）；
# /task all 在共享线程下改为串行，让后一个 Agent 看到前一个的回答。false 保持各 Agent 隔离。
SHARED_AGENT_CONTEXT=false
# ---- 旧式目录字段（仅用于向 workspaces.roots 的保守迁移）----
# 权限已统一由 YAML 的 workspaces.roots 声明；下面两个字段只为兼容旧部署：
#   FILE_READ_ROOT  → 成员 read、管理员 read（只读根不会升级为可写）
#   FILE_WRITE_ROOT → 成员无权限、管理员 read/edit（旧写根历史上只有管理员能写）
# 迁移差异会打印在启动日志与 /status 的 workspaces.notes 中。新部署请留空并改配 workspaces.roots。
FILE_READ_ROOT=
# 单次读取字节上限（broker 读取预算的一部分；默认 512 KiB）
FILE_READ_MAX_BYTES=524288
FILE_WRITE_ROOT=
# 单次写入字节上限（broker/ChangeSet 默认 128 KiB；此处保留旧字段以便迁移告警）
FILE_WRITE_MAX_BYTES=65536
# 已废弃：新的写路径由 broker/ChangeSet 控制（覆盖前自动备份），该开关不再参与权限判定
FILE_WRITE_ALLOW_OVERWRITE=false
# 每用户每分钟最多调用次数
RATE_LIMIT_PER_MINUTE=6
# 审批码有效期（秒）
APPROVAL_TTL_SECONDS=300

# ---------- 其他 ----------
LOG_LEVEL=INFO
# 可选：YAML 配置文件路径（环境变量优先级更高），见 config.example.yaml
# CONFIG_FILE=config.yaml

# ---------- 本机 Harness（需先安装对应应用） ----------
# api 保留兼容API；harness 使用本机dsh及独立临时配置
DEEPSEEK_BACKEND=api
# harness 模式建议 DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_HARNESS_BINARY=/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh
DEEPSEEK_HARNESS_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_HARNESS_WORKDIR=.
# ZCode复用GLM_API_KEY与GLM_BASE_URL，单独启用；避免/all重复时禁用GLM_ENABLED
ZCODE_ENABLED=false
ZCODE_NODE=/Applications/DeepSeek Harness.app/Contents/Resources/runtime/primary-runtime/dependencies/node/bin/node
ZCODE_ENTRY=/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs
ZCODE_BUILTIN=/Applications/ZCode.app/Contents/Resources/config/provider/zcode-builtin.json
ZCODE_MODEL=glm-5.3
ZCODE_CATALOG=data/zcode_models.json
# 文件任务模式：ZCode 模型可在该目录内自主读写文件（写操作限目录内、越界自动拒绝）；
# 留空 = 纯文本模式（无任何工具）。机器人项目目录始终受保护。
ZCODE_WORKSPACE_ROOT=

# Codex文件任务：JSON数组，仅允许这些根目录下的显式--dir目标。空数组禁用。
CODEX_ALLOWED_ROOTS=[]

# ---------- 多 Agent 协作 /team（V1 全部为无工具文本步骤，无文件/目录能力） ----------
# 是否启用 /team 命令（默认 true；仅开启本地命令，不会自动发起模型调用）
TEAM_ENABLED=true
# 单个计划的步骤数上限
TEAM_MAX_STEPS=8
# 同一用户跨群同时活动的团队任务数（queued/running）
TEAM_MAX_ACTIVE_PER_USER=1
# 全局同时活动的团队任务数（queued/running）
TEAM_MAX_ACTIVE_GLOBAL=4
# 全局协作步骤并发上限（同一后端的串行约束仍由各适配器自己保证）
TEAM_MAX_PARALLEL_STEPS=2
# 团队目标与单步指令各自的长度上限
TEAM_MAX_PROMPT_CHARS=12000
# 单步总输入上限（总目标+指令+直接上游成功答复）；超限在调用前报 input_limit，不静默截断
TEAM_MAX_INPUT_CHARS=60000
# 单步最终答复上限；超限报 output_limit，不把截断文本交给下游
TEAM_MAX_OUTPUT_CHARS=30000
# 单轮总时限（秒），覆盖排队与执行；超时停止未完成步骤
TEAM_WORKFLOW_TIMEOUT_SECONDS=1800
# 单步模型调用时限（秒）；0 = 自动取 min(REQUEST_TIMEOUT_SECONDS, 300)
TEAM_STEP_TIMEOUT_SECONDS=0
# 说明：/team 按「群 × 发起人」隔离，管理员也不能查看或控制他人任务；
# 服务关闭/重启会把未完成任务标记 interrupted，需用户显式 /team retry 才恢复，绝不自动重跑。

# ---------- 统一控制台（schema_version 2） ----------
# 结构化配置（backends / agents / workspaces / commands / api）建议写在 YAML 里，
# 用 CONFIG_FILE=config.yaml 启用；下面这些环境变量优先级高于 YAML 与 .env 中的 YAML 值。
# 需要临时覆盖 YAML 时，可把整段 JSON 放进对应变量（示例见 README）。
CONSOLE_BACKENDS=
CONSOLE_AGENTS=
CONSOLE_WORKSPACES=
CONSOLE_COMMANDS=
CONSOLE_API=
SCHEMA_VERSION=2

# 统一 HTTP API 的 Token 环境变量名（真实 Token 值放这里，不要写进 YAML）
# 例：QQ_CONSOLE_API_TOKEN=请自行生成一串随机值
CONSOLE_API_TOKEN_ENV=QQ_CONSOLE_API_TOKEN
QQ_CONSOLE_API_TOKEN=

# 执行 worker 上限：进程内目录锁只保证单进程互斥；>1 时必须提供跨进程锁，否则启动拒绝
WORKSPACE_MAX_WORKERS=1
WORKSPACE_CROSS_PROCESS_LOCK=false
WORKSPACE_LOCK_TIMEOUT_SECONDS=30

# ---------- 旧式目录字段（会被保守迁移为 workspaces.roots，并在启动日志/状态中列出差异） ----------
# 只读根：迁移后成员仍只有 read，不会升级为可写
FILE_READ_ROOT=
# 旧写根：迁移后成员无权限，管理员 read/edit（历史上只有管理员能写）
FILE_WRITE_ROOT=
